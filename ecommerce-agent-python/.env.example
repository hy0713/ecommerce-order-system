# ===== 服务 =====
APP_HOST=0.0.0.0
APP_PORT=8000

# 允许的前端来源，逗号分隔；* 表示放开（仅本地演示），生产请收敛
CORS_ORIGINS=*

# ===== 大模型（OpenAI 兼容协议，可替换任意兼容服务）=====
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=2048
LLM_TIMEOUT=120
LLM_MAX_RETRIES=2

# ===== MySQL（与电商系统共用实例）=====
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=root123456
MYSQL_DB=ecommerce

# ===== Redis Stack（独立 6380 端口，勿动电商 6379）=====
REDIS_HOST=127.0.0.1
REDIS_PORT=6380
REDIS_DB=0
REDIS_PASSWORD=

# ===== RabbitMQ（与电商系统共用实例）=====
RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# ===== 电商系统网关 =====
ECOM_GATEWAY_BASE=http://localhost:8080

# ===== Embedding（本地模型，无需 API Key）=====
EMBED_MODEL=BAAI/bge-small-zh-v1.5
EMBED_DIM=512
EMBED_CACHE_DIR=models
# HuggingFace 镜像（国内下载加速），模型预热后可离线
HF_ENDPOINT=https://hf-mirror.com

# ===== Agent 参数 =====
CTX_TURNS=5
MAX_HISTORY_CHARS=4000
RAG_TOP_K=3
# 相似度阈值：注意要落在你语料的实际相似度分布内，设太高会让向量路完全失效（0 命中）
RAG_MIN_SCORE=0.5
# 混合检索：BM25 关键词路 + 向量路，RRF 融合（score = Σ 1/(k+rank)）
# 关掉即退回纯向量检索，便于 A/B 对比
RAG_HYBRID_ENABLED=true
RRF_K=60
KEYWORD_CANDIDATES=10
RAG_AFTERSALE_MIN_SCORE=0.5
CHUNK_SIZE=500
CHUNK_OVERLAP=100
UPLOAD_MAX_MB=20
